{
  "name": "sw-postgres-mcp",
  "version": "0.3.1",
  "description": "Safe-write Postgres MCP server with dual-role pools and preview-before-execute",
  "mcpName": "io.github.jpka/sw-postgres-mcp",
  "type": "module",
  "license": "MIT",
  "author": "jpka",
  "homepage": "https://github.com/jpka/sw-postgres-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpka/sw-postgres-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jpka/sw-postgres-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgres",
    "postgresql",
    "claude",
    "claude-desktop",
    "llm-agent",
    "database",
    "safe-write",
    "audit-log"
  ],
  "bin": {
    "sw-postgres-mcp": "dist/index.js"
  },
  "files": ["dist", "docker/init", "config.example.json"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "lint": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "pg": "^8.13.0",
    "safe-write-mcp-core": "^0.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
